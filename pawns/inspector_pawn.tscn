; static_suit (WI-67 §11): the inspector follows the tier and nothing else - no
; trips, no mood, no hold. At Tier 1 that means they arrive and stay suited, so an
; inspection can never fail on air or heat the player was not yet asked to
; provide; from Tier 2 they are unsuited and WI-26's harm-fails-the-run rule works
; exactly as it always has.
[node name="PawnSuitComponent" type="Node2D" parent="." index="3"]
script = ExtResource("5_suit")
static_suit = true
suited_frames = ExtResource("6_suited")
unsuited_frames = ExtResource("7_unsuited")
