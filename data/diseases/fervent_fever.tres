[resource]
script = ExtResource("1_disease")
id = &"fervent_fever"
display_name = "Fervent Fever"
description = "A wired, restless fever. The afflicted burn hot and pace fast - unnaturally quick on their feet - while their focus and patience fray. Mildly catching in close quarters."
stages = Array[ExtResource("2_stage")]([SubResource("Stage_fever_0"), SubResource("Stage_fever_1")])
