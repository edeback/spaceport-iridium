[resource]
script = ExtResource("1_disease")
id = &"void_sickness"
display_name = "Void Sickness"
description = "The creeping disorientation of too many hours outside the hull. Vision swims and hands shake, dulling intellect and aim. It doesn't spread - only the vacuum gives it - but it worsens the longer a spacer stays exposed."
stages = Array[ExtResource("2_stage")]([SubResource("Stage_void_0"), SubResource("Stage_void_1")])
contagious_rate = 0.0
acquisition = Array[StringName]([&"space"])
treat_hours_base = 12.0
cure_at_stage_reset = false
min_station_tier = 2
