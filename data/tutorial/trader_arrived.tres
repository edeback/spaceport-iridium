trigger_filter = &""
dialogue = ExtResource("2_script")
cue = "trader"
title = "Trading with visiting ships"
body = "Traders let you buy what your industry cannot make yet, and shipping iron ore is what ARC measures your tier against. Place orders early - an order set up before a ship docks fills the moment one arrives, and a trader leaves whether or not you got to it."
has_subject = false
