dialogue = ExtResource("2_script")
cue = "resigning"
title = "Crew leave when they are unhappy"
body = "An unhappy crew member waits out a short grace period and then takes the next ship; meet their needs inside that window and they withdraw the notice. If everyone leaves and you cannot afford a replacement, ARC confiscates the station."
has_subject = true
