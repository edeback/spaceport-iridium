[gd_resource type="Resource" script_class="TutorialHintData" format=3]

[ext_resource type="Script" path="res://data/tutorial/tutorial_hint_data.gd" id="1_hint"]
[ext_resource type="Resource" path="res://data/dialogue/tutorial/hint_need_sleep.dialogue" id="2_script"]

[resource]
script = ExtResource("1_hint")
id = &"need_sleep"
trigger = &"need_critical"
trigger_filter = &"sleep"
dialogue = ExtResource("2_script")
cue = "sleep"
title = "Crew need beds they can reach"
body = "Sleep needs a free bunk and a route to walk to it. The console's crew chip shows people aboard against bunks available - keep the second number ahead of the first, and treat it going amber as somebody sleeping nowhere."
has_subject = true
metadata/_custom_type_script = "res://data/tutorial/tutorial_hint_data.gd"
