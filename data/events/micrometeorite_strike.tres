[resource]
script = ExtResource("1_evdata")
id = &"micrometeorite_strike"
title = "Micrometeorite Strike"
body = "A micrometeorite has punched through the hull! The module is venting atmosphere - emergency bulkheads will take time to seal. Keep oxygen reserves flowing."
