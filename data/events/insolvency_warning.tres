[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/events/event_data.gd" id="1_evdata"]
[ext_resource type="Resource" path="res://data/dialogue/events/insolvency_warning.dialogue" id="3_script"]

[resource]
script = ExtResource("1_evdata")
id = &"insolvency_warning"
title = "ARC Repossession Notice"
body = "The Astral Resource Corporation notes your station is running in the red. Settle the debt within a few cycles or ARC will move to repossess the station. They offer a loan - at their usual terms."
dialogue = ExtResource("3_script")
cue = "notice"
weight = 0.0
min_cycle = 999
cooldown_cycles = 0
