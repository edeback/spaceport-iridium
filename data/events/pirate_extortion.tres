[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" uid="uid://p3ck66sptlw8" path="res://data/events/event_data.gd" id="1_evdata"]
[ext_resource type="Script" uid="uid://c22hiw2cjh3o" path="res://data/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" uid="uid://dcwi3tudyit34" path="res://data/events/event_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://crby7y3cmmsfa" path="res://data/events/event_condition.gd" id="4_cond"]
[ext_resource type="Script" uid="uid://bdyegqvn4wcld" path="res://data/resources/resource_data.gd" id="5_rdata"]
[ext_resource type="Resource" uid="uid://bwm1nd0ra2f1x" path="res://data/resources/credits.tres" id="6_credits"]
[ext_resource type="Script" path="res://data/events/effects/effect_pirate_raid.gd" id="7_raid"]
[ext_resource type="Script" uid="uid://bgky26a16q1sw" path="res://data/events/conditions/condition_min_credits.gd" id="8_mincred"]
[ext_resource type="Script" uid="uid://dfisauhtobwoj" path="res://data/events/conditions/condition_min_crew.gd" id="9_mincrew"]

[sub_resource type="Resource" id="Resource_raid"]
script = ExtResource("7_raid")
strength_override = -1.0

[sub_resource type="Resource" id="Resource_pay"]
script = ExtResource("2_choice")
label = "Pay the ransom"
description = "Buy them off. It stings, but the station stays whole."
cost = Dictionary[ExtResource("5_rdata"), int]({
ExtResource("6_credits"): 600
})
effects = Array[ExtResource("3_effect")]([])

[sub_resource type="Resource" id="Resource_refuse"]
script = ExtResource("2_choice")
label = "Refuse them"
description = "Tell them where to go. They will open fire - modules will take damage and hull breaches."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_raid")])

[sub_resource type="Resource" id="Resource_cond_cred"]
script = ExtResource("8_mincred")
min_credits = 400

[sub_resource type="Resource" id="Resource_cond_crew"]
script = ExtResource("9_mincrew")
min_crew = 2

[resource]
script = ExtResource("1_evdata")
id = &"pirate_extortion"
title = "Pirate Extortion"
body = "A raider corvette drifts into weapons range and hails you on an open channel. Their captain wants a tribute of credits - or they start shooting."
weight = 0.6
min_cycle = 6
cooldown_cycles = 10
conditions = Array[ExtResource("4_cond")]([SubResource("Resource_cond_cred"), SubResource("Resource_cond_crew")])
choices = Array[ExtResource("2_choice")]([SubResource("Resource_pay"), SubResource("Resource_refuse")])
