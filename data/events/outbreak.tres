[resource]
script = ExtResource("1_evdata")
id = &"outbreak"
title = "Disease Outbreak"
body = "Something's going around. A contagious illness has taken hold among the crew - keep the afflicted rested and treated before it spreads through the whole station."
weight = 0.5
min_cycle = 4
cooldown_cycles = 8
conditions = Array[ExtResource("4_condition")]([SubResource("Resource_mincrew"), SubResource("Resource_unlocked")])
auto_effects = Array[ExtResource("2_effect")]([SubResource("Resource_outbreak")])
