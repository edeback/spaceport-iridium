[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/events/event_data.gd" id="1_evdata"]
[ext_resource type="Script" path="res://data/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://data/events/event_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://data/events/effects/effect_inspection_response.gd" id="4_resp"]

[sub_resource type="Resource" id="Resource_accept_eff"]
script = ExtResource("4_resp")
accept = true

[sub_resource type="Resource" id="Resource_accept"]
script = ExtResource("2_choice")
label = "Welcome the inspector"
description = "An ARC inspector tours the station. Pass, and it's promoted to the next tier."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_accept_eff")])

[sub_resource type="Resource" id="Resource_decline_eff"]
script = ExtResource("4_resp")
accept = false

[sub_resource type="Resource" id="Resource_decline"]
script = ExtResource("2_choice")
label = "Not right now"
description = "Turn ARC away for now. They'll offer another inspection in a few cycles."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_decline_eff")])

[resource]
script = ExtResource("1_evdata")
id = &"arc_inspection_offer"
title = "ARC Inspection Request"
body = "The Astral Resource Corporation has reviewed your station's exports and is prepared to inspect it for promotion to the next tier. An inspector will disembark at your docking bay and tour key facilities - keep them safe and give them a clear route. Receive them?"
weight = 0.0
min_cycle = 999
cooldown_cycles = 0
choices = Array[ExtResource("2_choice")]([SubResource("Resource_accept"), SubResource("Resource_decline")])
