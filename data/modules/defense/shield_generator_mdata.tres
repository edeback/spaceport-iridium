script = ExtResource("3_mdata")
id = &"shield_generator_mdata"
name = "Shield Generator"
description = "Projects a circular deflector bubble. Any laser hit landing inside the radius is soaked by its capacitor instead of the module beneath it - until the bank empties and the shield drops offline to recharge. Keep it powered; a starved shield is a dead one."
