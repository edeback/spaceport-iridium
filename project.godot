; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Spaceport Iridium"
config/version="0.1.0-dev"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ModManager="*res://scripts/managers/mod_manager.gd"
Global="*res://scripts/managers/global.gd"
SignalBus="*res://scripts/managers/signal_bus.gd"
Panku="*res://addons/panku_console/console.tscn"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
DialogueManager="*uid://c3rodes2l3gxb"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[dialogue_manager]

editor/advanced/custom_test_scene_path="uid://x7nevk3pah8p"
runtime/balloon_path="res://ui/dialogue/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=1
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Spaceport Iridium"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/m12_name_generator/plugin.cfg", "res://addons/module_editor/plugin.cfg", "res://addons/panku_console/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/yard/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="uid://djqf6raokvcao"

