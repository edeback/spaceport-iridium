[gd_scene format=3]

[ext_resource type="Script" path="res://ui/windows/ui_crew_recruitment.gd" id="1_recruit"]

[node name="UiCrewRecruitment" type="PanelContainer" node_paths=PackedStringArray("status_label", "candidate_list")]
script = ExtResource("1_recruit")
status_label = NodePath("MarginContainer/ContentsBox/StatusLabel")
candidate_list = NodePath("MarginContainer/ContentsBox/CandidateList")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 2
theme_override_constants/margin_top = 2
theme_override_constants/margin_right = 2
theme_override_constants/margin_bottom = 2

[node name="ContentsBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="StatusLabel" type="Label" parent="MarginContainer/ContentsBox"]
layout_mode = 2
theme_type_variation = &"MetaLine"
text = "Crew 0 / 0 beds"

[node name="CandidateList" type="VBoxContainer" parent="MarginContainer/ContentsBox"]
layout_mode = 2
theme_override_constants/separation = 4
