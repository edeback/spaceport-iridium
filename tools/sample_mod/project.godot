; WI-47 M9 spike - throwaway mod source project.
; Deliberately bare: it contains ONLY the mod's own files, so anything the
; resulting .pck resolves at runtime provably came from the GAME's res://,
; not from a vanilla script the pack happened to carry along.

config_version=5

[application]

config/name="Spike Mod"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor]

export/convert_text_resources_to_binary=false
