# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
# The editor's atomic-save leftovers (`scene.tscn<digits>.tmp`). Six were once
# committed by accident (WI-68 F16).
*.tmp
.import/
export.cfg
export_presets.cfg
# ...except the sample mod's, which IS the fixture: it is how the .pck gets
# built, and both of its presets are load-bearing (WI-47 M9 tested text and
# binary-token script export separately).
!tools/sample_mod/export_presets.cfg

!*.import

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
